# Local Docker Postgres (`docker compose up -d`). Use the same value for both.
DATABASE_URL="postgresql://gapbook:gapbook@localhost:5432/gapbook"
DIRECT_URL="postgresql://gapbook:gapbook@localhost:5432/gapbook"

# Cookie session signing key. Required in every environment.
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# --- Production (Vercel + Neon or Supabase) ---
# DATABASE_URL  Pooled connection for the Next.js app (serverless).
#               Neon: hostname contains `-pooler`. Append:
#                 ?sslmode=require&pgbouncer=true
#               Supabase: Transaction pooler URI (port 6543) with
#                 ?sslmode=require&pgbouncer=true
# DIRECT_URL    Direct / unpooled connection for `prisma migrate deploy`.
#               Neon: hostname WITHOUT `-pooler` (also called DATABASE_URL_UNPOOLED).
#               Supabase: direct URI (port 5432), sslmode=require.
#               The Vercel build script copies DATABASE_URL_UNPOOLED → DIRECT_URL
#               if DIRECT_URL is unset (Neon’s Vercel integration).
# AUTH_SECRET   Unique long random string per environment (Production vs Preview).
#
# Do not add Stripe keys. Job money is paid directly; WeekSlot bills a 5% success
# fee after the fact (0% on the first two bookings). No deposit.
